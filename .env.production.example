DJANGO_SETTINGS_MODULE=config.production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=GENERATE_A_NEW_RANDOM_SECRET_WITH_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
DJANGO_TRUST_PROXY_HTTPS=True
DJANGO_SECURE_HSTS_SECONDS=3600
APPLICATION_TRUSTED_PROXY_IPS=127.0.0.1,::1
APPLICATION_POST_LIMIT=20
APPLICATION_POST_WINDOW=600
APPLICATION_GET_LIMIT=120
APPLICATION_GET_WINDOW=60
SITE_CONTENT_CACHE_TIMEOUT=300
DB_NAME=tukid
DB_USER=tukid_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
